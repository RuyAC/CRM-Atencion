NODE_ENV=production
DOMAIN=tu-dominio.com
ATENCION_PUBLIC_ORIGIN=https://tu-dominio.com
ATENCION_RESTAURANT_NAME=Restaurante inicial
ATENCION_OWNER_EMAIL=propietario@tu-dominio.com
ATENCION_ADMIN_EMAIL=administrador@tu-dominio.com
ATENCION_OWNER_PASSWORD=REEMPLAZAR_POR_UN_SECRETO_UNICO
ATENCION_ADMIN_PASSWORD=REEMPLAZAR_POR_OTRO_SECRETO_UNICO
ATENCION_MONITOR_PIN=REEMPLAZAR
RESEND_API_KEY=REEMPLAZAR
MAIL_FROM=AUnToque <cuentas@tu-dominio.com>
BACKUP_INTERVAL_HOURS=24
MAX_RESTAURANTS=500
REQUIRE_PLATFORM_MFA=true
RELEASE_TAG=local

# Datos comerciales pendientes. Completar sin comillas adicionales al valor.
BUSINESS_NAME=
BUSINESS_ADDRESS=
BUSINESS_JURISDICTION=
SALES_EMAIL=
SUPPORT_EMAIL=
BUSINESS_WHATSAPP=
SUPPORT_HOURS=
PAYMENT_INSTRUCTIONS=
CANCELLATION_POLICY=
PRIVACY_RETENTION=
LEGAL_VERSION=
LEGAL_PUBLISHED=false

# Activar el perfil monitoring; el webhook debe aceptar JSON con campo text.
ALERT_WEBHOOK=
MONITOR_INTERVAL_SECONDS=60
MAX_BACKUP_AGE_HOURS=30
# Completar solo al activar el perfil offsite:
# OFFSITE_STATUS_FILE=/status/offsite-success
MAX_OFFSITE_AGE_HOURS=8
