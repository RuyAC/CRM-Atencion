FROM node:24-bookworm-slim
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3001 DB_PATH=/var/lib/auntoque/data/platform.sqlite MEDIA_DIR=/var/lib/auntoque/uploads BACKUP_DIR=/var/backups/auntoque
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev && mkdir -p /var/lib/auntoque /var/backups/auntoque && chown -R node:node /var/lib/auntoque /var/backups/auntoque
COPY dist ./dist
COPY server ./server
COPY shared ./shared
COPY scripts ./scripts
USER node
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:3001/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["sh","-c","node scripts/preflight.mjs && node server/index.mjs"]
